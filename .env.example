# Supabase (projeto compartilhado com KiComanda, schema zapcomanda)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
NEXT_PUBLIC_APP_URL=https://seudominio.com
PLAN_BASIC_PRICE=49
PLAN_PRO_PRICE=79
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# WhatsApp — escolha "evolution" ou "zapi"
WHATSAPP_PROVIDER=evolution
WHATSAPP_WEBHOOK_SECRET=seu-segredo-webhook

# Evolution API
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE_NAME=nome-da-instancia

# Z-API (alternativa)
ZAPI_INSTANCE_URL=https://api.z-api.io/instances/SUA_INSTANCIA/token/SEU_TOKEN
ZAPI_TOKEN=seu-client-token

# Asaas
ASAAS_ENV=sandbox
ASAAS_API_KEY=sua-api-key-asaas
ASAAS_WEBHOOK_TOKEN=seu-token-webhook-asaas
